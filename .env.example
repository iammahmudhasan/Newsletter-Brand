# ==========================================
# AI Signal - Environment Configuration
# ==========================================

# Application URL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection
# Supported by Supabase, Neon, or Local Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_signal

# Security & Cryptographic Tokens
# Generate with: openssl rand -hex 32
AUTH_SECRET=super-secret-cryptographic-salt-change-in-production-32-chars
ADMIN_PASSWORD=change-me-secure-admin-pass

# Email Delivery Provider
# Options: "console" (offline mock preview), "resend", "ses"
EMAIL_PROVIDER=console
EMAIL_FROM_NAME="AI Signal"
EMAIL_FROM_ADDRESS="newsletter@aisignal.dev"
EMAIL_REPLY_TO="curator@aisignal.dev"

# Resend Configuration (optional if EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_123456789

# Amazon SES Configuration (optional if EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Webhook Verification Secret
EMAIL_WEBHOOK_SECRET=webhook-signing-secret
