{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "types": ["bun"],
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@ai-signal/db": ["packages/db/src"],
      "@ai-signal/db/*": ["packages/db/src/*"],
      "@ai-signal/email": ["packages/email/src"],
      "@ai-signal/email/*": ["packages/email/src/*"],
      "@ai-signal/queue": ["packages/queue/src"],
      "@ai-signal/queue/*": ["packages/queue/src/*"],
      "@ai-signal/config": ["packages/config/src"],
      "@ai-signal/config/*": ["packages/config/src/*"],
      "@ai-signal/validation": ["packages/validation/src"],
      "@ai-signal/validation/*": ["packages/validation/src/*"]
    }
  },
  "exclude": ["node_modules", ".next"]
}
